@model CartViewModel
@{
    ViewData["Title"] = "Mon Panier - BrasilBurger";
    var checkout = (CheckoutViewModel?)ViewData["Checkout"] ?? new CheckoutViewModel();
    var zones = (List<Zone>?)ViewData["Zones"] ?? new List<Zone>();
}

<style>
    .cart-header {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        color: white;
        padding: 2.5rem;
        border-radius: 15px;
        margin-bottom: 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cart-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 800;
    }

    .cart-container {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @@media (max-width: 992px) {
        .cart-container {
            grid-template-columns: 1fr;
        }
    }

    .cart-items-section {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .cart-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        border: 2px solid #ecf0f1;
        border-radius: 12px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .cart-item:hover {
        border-color: #E74C3C;
        background: #FEF5F3;
    }

    .cart-item-image {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #ecf0f1 0%, #bdc3c7 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .cart-item-details {
        flex: 1;
    }

    .cart-item-name {
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 0.3rem;
    }

    .cart-item-type {
        font-size: 0.8rem;
        color: #999;
        margin-bottom: 0.5rem;
    }

    .cart-item-price {
        font-weight: 700;
        color: #E74C3C;
    }

    .cart-item-quantity {
        font-weight: 600;
        color: #666;
        margin: 0.5rem 0;
    }

    .cart-item-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: flex-end;
    }

    .btn-delete {
        background: #FADBD8;
        border: none;
        color: #E74C3C;
        border-radius: 8px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-delete:hover {
        background: #E74C3C;
        color: white;
        transform: scale(1.1);
    }

    .cart-empty {
        text-align: center;
        padding: 4rem 2rem;
    }

    .cart-empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .cart-empty-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 0.5rem;
    }

    .cart-empty-text {
        color: #999;
        margin-bottom: 2rem;
    }

    .summary-card {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        position: sticky;
        top: 100px;
    }

    .summary-title {
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 1.5rem;
        font-size: 1.2rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ecf0f1;
    }

    .summary-row.total {
        font-weight: 800;
        font-size: 1.3rem;
        border-bottom: none;
        padding-top: 1rem;
        border-top: 2px solid #E74C3C;
        color: #E74C3C;
    }

    .summary-label {
        color: #666;
    }

    .summary-value {
        font-weight: 600;
        color: #2C3E50;
    }

    .delivery-option {
        padding: 1rem;
        border: 2px solid #ecf0f1;
        border-radius: 10px;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .delivery-option:hover {
        border-color: #E74C3C;
        background: #FEF5F3;
    }

    .delivery-option input[type="radio"] {
        accent-color: #E74C3C;
    }

    .delivery-option input[type="radio"]:checked ~ label {
        font-weight: 700;
        color: #E74C3C;
    }

    .delivery-label {
        cursor: pointer;
        font-weight: 600;
        color: #2C3E50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .delivery-desc {
        font-size: 0.85rem;
        color: #999;
        margin-left: 1.8rem;
        margin-top: 0.3rem;
    }

    .zone-select {
        margin-top: 1rem;
        margin-left: 1.8rem;
    }

    .form-select {
        border: 2px solid #ecf0f1;
        border-radius: 8px;
        padding: 0.7rem;
        transition: all 0.3s ease;
    }

    .form-select:focus {
        border-color: #E74C3C;
        box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.15);
    }

    .btn-checkout {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        border: none;
        color: white;
        font-weight: 700;
        padding: 1rem;
        border-radius: 10px;
        width: 100%;
        margin-top: 1.5rem;
        transition: all 0.3s ease;
        font-size: 1.1rem;
    }

    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.3);
        color: white;
    }

    .btn-checkout:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .alert-auth {
        background: #FEF5F3;
        border: 2px solid #E74C3C;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
    }

    .alert-auth a {
        color: #E74C3C;
        font-weight: 700;
        text-decoration: none;
    }

    .alert-auth a:hover {
        text-decoration: underline;
    }

    .btn-continue-shopping {
        background: white;
        border: 2px solid #E74C3C;
        color: #E74C3C;
        font-weight: 600;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .btn-continue-shopping:hover {
        background: #FEF5F3;
        color: #E74C3C;
    }

    .btn-clear-cart {
        background: transparent;
        border: 2px solid #999;
        color: #999;
        font-weight: 600;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-clear-cart:hover {
        border-color: #E74C3C;
        color: #E74C3C;
    }

    .security-badge {
        font-size: 0.85rem;
        color: #27AE60;
        margin-top: 1rem;
        font-weight: 600;
    }

    .cart-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    @@media (max-width: 768px) {
        .cart-actions {
            flex-direction: column;
        }

        .summary-card {
            position: static;
        }

        .cart-header {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<div class="cart-header">
    <div>
        <h1>🛒 Mon Panier</h1>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">@Model.Items.Count</div>
        <div style="font-size: 0.9rem; opacity: 0.9;">article@(Model.Items.Count > 1 ? "s" : "")</div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-triangle me-2"></i>Erreur de validation
        </h5>
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="cart-items-section">
        <div class="cart-empty">
            <div class="cart-empty-icon">🛒</div>
            <div class="cart-empty-title">Votre panier est vide</div>
            <div class="cart-empty-text">Parcourez notre menu et ajoutez des délicieux plats à votre panier!</div>
            <a asp-controller="Catalog" asp-action="Index" class="btn-continue-shopping">
                <i class="bi bi-arrow-left me-2"></i>Retour au menu
            </a>
        </div>
    </div>
}
else
{
    <div class="cart-container">
        <div class="cart-items-section">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var it = Model.Items[i];
                <div class="cart-item">
                    <div class="cart-item-image">
                        @if (it.TypeItem == "BURGER")
                        {
                            <span>🍔</span>
                        }
                        else if (it.TypeItem == "MENU")
                        {
                            <span>📦</span>
                        }
                        else if (it.TypeItem == "BOISSON")
                        {
                            <span>🥤</span>
                        }
                        else if (it.TypeItem == "FRITE")
                        {
                            <span>🍟</span>
                        }
                        else
                        {
                            <span>🍽️</span>
                        }
                    </div>
                    <div class="cart-item-details">
                        <div class="cart-item-name">@it.Nom</div>
                        <div class="cart-item-type">@it.TypeItem</div>
                        <div class="cart-item-price">@it.PrixUnitaire FCFA</div>
                        <div class="cart-item-quantity">
                            <i class="bi bi-bag me-1"></i>@it.Quantite unité@(it.Quantite > 1 ? "s" : "")
                        </div>
                    </div>
                    <div class="cart-item-actions">
                        <div style="text-align: right;">
                            <div style="font-weight: 700; font-size: 1.2rem; color: #E74C3C;">@it.SousTotal FCFA</div>
                            <form method="post" asp-controller="Cart" asp-action="Checkout">
                                <input type="hidden" name="index" value="@i" />
                                <button type="submit" class="btn-delete" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <div class="cart-actions">
                <form method="post" asp-controller="Cart" asp-action="Clear">
                    <button type="submit" class="btn-clear-cart">
                        <i class="bi bi-trash me-2"></i>Vider le panier
                    </button>
                </form>
                <a asp-controller="Catalog" asp-action="Index" class="btn-continue-shopping">
                    <i class="bi bi-plus-circle me-2"></i>Continuer mes achats
                </a>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-title">
                <i class="bi bi-receipt me-2"></i>Résumé de commande
            </div>

            <div class="summary-row">
                <span class="summary-label">Sous-total (@Model.Items.Sum(i => i.Quantite) article@(Model.Items.Count > 1 ? "s" : ""))</span>
                <span class="summary-value">@Model.Total FCFA</span>
            </div>

            <div id="deliveryFeeContainer" style="display: none;">
                <div class="summary-row">
                    <span class="summary-label">Frais de livraison</span>
                    <span class="summary-value" id="deliveryFee">0 FCFA</span>
                </div>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span id="grandTotal">@Model.Total FCFA</span>
            </div>

            @if (User?.Identity?.IsAuthenticated != true)
            {
                <div class="alert-auth">
                    <i class="bi bi-exclamation-triangle me-2"></i>Vous devez vous connecter pour finaliser votre commande.
                    <br />
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Cart/Index">Se connecter maintenant</a>
                </div>
            }
            else
            {
                <form method="post" asp-controller="Cart" asp-action="Checkout" id="checkoutForm">
                    <div style="margin-top: 1.5rem;">
                        <div style="font-weight: 700; color: #2C3E50; margin-bottom: 1rem;">
                            <i class="bi bi-truck me-2"></i>Mode de livraison
                        </div>

                        <div class="delivery-option">
                            <input class="form-check-input" type="radio" name="TypeCommande" id="pickupOption" value="TAKEAWAY" checked onchange="updateDeliveryFee()" />
                            <label class="delivery-label" for="pickupOption">
                                <i class="bi bi-shop"></i>À emporter
                            </label>
                            <p class="delivery-desc">Venez récupérer votre commande</p>
                        </div>

                        <div class="delivery-option">
                            <input class="form-check-input" type="radio" name="TypeCommande" id="deliveryOption" value="DELIVERY" onchange="updateDeliveryFee()" />
                            <label class="delivery-label" for="deliveryOption">
                                <i class="bi bi-truck"></i>Livraison à domicile
                            </label>
                            <p class="delivery-desc">Frais selon la zone sélectionnée</p>
                            
                            <div class="zone-select" id="zoneSelection" style="display: none;">
                                <select class="form-select" name="ZoneId" id="zoneId" onchange="updateDeliveryFee()">
                                    <option value="">-- Sélectionnez une zone --</option>
                                    @if (zones.Any())
                                    {
                                        foreach (var zone in zones)
                                        {
                                            <option value="@zone.Id" data-fee="@zone.PrixLivraison">
                                                @zone.Nom - @zone.PrixLivraison FCFA
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-checkout" id="checkoutButton">
                        <i class="bi bi-credit-card me-2"></i>Procéder au paiement
                    </button>

                    <div class="security-badge">
                        <i class="bi bi-shield-lock me-1"></i>Paiement sécurisé
                    </div>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateDeliveryFee() {
            const deliveryOption = document.getElementById('deliveryOption');
            const zoneSelection = document.getElementById('zoneSelection');
            const deliveryFeeContainer = document.getElementById('deliveryFeeContainer');
            const zoneSelect = document.getElementById('zoneId');

            if (deliveryOption.checked) {
                zoneSelection.style.display = 'block';
                deliveryFeeContainer.style.display = 'block';
            } else {
                zoneSelection.style.display = 'none';
                deliveryFeeContainer.style.display = 'none';
                updateGrandTotal(0);
            }

            if (zoneSelect.value) {
                const selected = zoneSelect.options[zoneSelect.selectedIndex];
                const fee = parseInt(selected.dataset.fee) || 0;
                updateGrandTotal(fee);
            }
        }

        function updateGrandTotal(fee) {
            const subtotal = @Model.Total;
            const total = subtotal + fee;
            document.getElementById('deliveryFee').textContent = fee + ' FCFA';
            document.getElementById('grandTotal').textContent = total + ' FCFA';
        }

        // Initialiser
        updateDeliveryFee();
    </script>
}