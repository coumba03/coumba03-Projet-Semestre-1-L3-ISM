@model CartViewModel
@{
    ViewData["Title"] = "Mon Panier - BrasilBurger";
    var checkout = (CheckoutViewModel?)ViewData["Checkout"] ?? new CheckoutViewModel();
    var zones = (List<Zone>?)ViewData["Zones"] ?? new List<Zone>();
}

<link rel="stylesheet" href="~/css/cart.css" />
<script>
    // expose subtotal for external JS
    window.cartSubtotal = @Model.Total;
</script>
    

<div class="cart-header">
    <div>
        <h1>🛒 Mon Panier</h1>
    </div>
                                    

</div>

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <h4 class="alert-heading">@TempData["SuccessMessage"]</h4>
            @if (TempData["OrderId"] != null)
            {
                <p class="mb-0">Votre numéro de commande est : <strong>@TempData["OrderId"]</strong></p>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Mon Panier</h1>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Continuer mes achats
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <h5 class="alert-heading">Erreur de validation</h5>
            <ul class="mb-0">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-cart-x" style="font-size: 4rem; color: #6c757d;"></i>
            </div>
            <h3 class="mb-3">Votre panier est vide</h3>
            <p class="text-muted mb-4">Parcourez notre menu et ajoutez des délicieux plats à votre panier !</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-success btn-lg px-4">
                <i class="bi bi-utensils"></i> Voir le menu
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50%;">Article</th>
                                        <th class="text-end">Prix unitaire</th>
                                        <th class="text-center">Qté</th>
                                        <th class="text-end">Sous-total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var it = Model.Items[i];
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        <div class="bg-light rounded" style="width: 60px; height: 60px;">
                                                            <!-- Placeholder pour l'image -->
                                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                                <i class="bi @(it.TypeItem == "BURGER" ? "bi-burger" : it.TypeItem == "MENU" ? "bi-box-seam" : "bi-cup-straw")" style="font-size: 1.5rem;"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-1">@it.Nom</h6>
                                                        <span class="badge bg-secondary">@it.TypeItem</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle text-end">@it.PrixUnitaire FCFA</td>
                                            <td class="align-middle text-center">@it.Quantite</td>
                                            <td class="align-middle text-end fw-bold">@it.SousTotal FCFA</td>
                                            <td class="align-middle text-end">
                                                <form method="post" asp-controller="Cart" asp-action="Remove" style="display:inline">
                                                    <input type="hidden" name="index" value="@i" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger remove-item" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <form method="post" asp-controller="Cart" asp-action="Clear">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-trash"></i> Vider le panier
                        </button>
                    </form>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="bi bi-plus-circle"></i> Continuer mes achats
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Résumé de la commande</h5>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total (@Model.Items.Sum(i => i.Quantite) @(Model.Items.Count > 1 ? "articles" : "article"))</span>
                            <span>@Model.Total FCFA</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2" id="deliveryFeeContainer" style="display: none;">
                            <span>Frais de livraison</span>
                            <span class="text-success fw-medium" id="deliveryFeeDisplay">0 FCFA</span>
                        </div>

                        <hr>
                        
                        <div class="d-flex justify-content-between fw-bold mb-4">
                            <span>Total</span>
                            <span id="grandTotal">@Model.Total</span> FCFA
                        </div>

                        @if (User?.Identity?.IsAuthenticated != true)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle"></i> Vous devez vous connecter pour finaliser votre commande.
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Cart/Index" class="alert-link">Se connecter</a>
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-controller="Cart" asp-action="Checkout" id="checkoutForm">
                                <div class="mb-3">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="TypeCommande" id="dineInOption" value="DINE_IN">
                                        <label class="form-check-label fw-medium" for="dineInOption">
                                            <i class="bi bi-cup-hot me-2"></i>Sur place
                                        </label>
                                        <p class="small text-muted ms-4 mt-1 mb-0">Consommez votre commande au restaurant</p>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="TypeCommande" id="pickupOption" value="TAKEAWAY" checked>
                                        <label class="form-check-label fw-medium" for="pickupOption">
                                            <i class="bi bi-shop me-2"></i>À emporter
                                        </label>
                                        <p class="small text-muted ms-4 mt-1 mb-0">Venez récupérer votre commande au restaurant</p>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="TypeCommande" id="deliveryOption" value="DELIVERY">
                                        <label class="form-check-label fw-medium" for="deliveryOption">
                                            <i class="bi bi-truck me-2"></i>Livraison à domicile
                                        </label>
                                        <p class="small text-muted ms-4 mt-1 mb-2">Frais de livraison selon la zone</p>
                                        
                                        <div id="zoneSelection" style="display: none;">
                                            <label class="form-label small fw-medium mb-2">Sélectionnez votre zone de livraison</label>
                                            <select class="form-select" name="ZoneId" id="zoneId">
                                                <option value="">-- Choisir une zone --</option>
                                                @if (ViewData["Zones"] is List<Zone> zonesList && zonesList.Any())
                                                {
                                                    foreach (var zone in zonesList)
                                                    {
                                                        <option value="@zone.Id" data-fee="@zone.PrixLivraison">
                                                            @zone.Nom - @zone.PrixLivraison FCFA
                                                        </option>
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="" disabled>Aucune zone de livraison disponible</option>
                                                }
                                            </select>
                                            <div class="text-danger small mt-1" id="zoneError" style="display: none;">
                                                Veuillez sélectionner une zone de livraison
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Mode de paiement</label>
                                        <select class="form-select" name="ModePaiement">
                                            <option value="WAVE">Wave</option>
                                            <option value="OM">Orange Money</option>
                                        </select>
                                    </div>

                                    <div class="d-grid gap-2 mt-4">
                                        <button type="submit" class="btn btn-success btn-lg w-100 py-3" id="checkoutButton" form="checkoutForm">
                                            <i class="bi bi-credit-card me-2"></i>Procéder au paiement
                                        </button>
                                    </div>

                                    <p class="small text-muted mb-0 mt-3">
                                        <i class="bi bi-shield-lock"></i> Paiement sécurisé. Vos données sont protégées.
                                    </p>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>



@section Scripts {
    <script src="~/js/cart.js"></script>
}
