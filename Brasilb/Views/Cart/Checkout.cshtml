@model CartViewModel
@{
    ViewData["Title"] = "Finaliser ma commande";
    var checkout = (CheckoutViewModel?)ViewData["Checkout"] ?? new CheckoutViewModel();
    var zones = (List<Zone>?)ViewData["Zones"] ?? new List<Zone>();
}

<link rel="stylesheet" href="~/css/cart.css" />

<div class="container py-5">
    <h1 class="mb-4">Finaliser ma commande</h1>
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-4">Détails de la commande</h2>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th class="text-end">Prix unitaire</th>
                                    <th class="text-center">Quantité</th>
                                    <th class="text-end">Sous-total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Nom</td>
                                        <td class="text-end">@item.PrixUnitaire FCFA</td>
                                        <td class="text-center">@item.Quantite</td>
                                        <td class="text-end">@item.SousTotal FCFA</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-4">Informations de livraison</h2>
                    <form method="post" asp-controller="Cart" asp-action="Checkout">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Type de commande</label>
                                <select class="form-select" name="TypeCommande" id="typeCommande">
                                    <option value="DINE_IN">Sur place</option>
                                    <option value="TAKEAWAY" selected>À emporter</option>
                                    <option value="DELIVERY">Livraison</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Mode de paiement</label>
                                <select class="form-select" name="ModePaiement">
                                    <option value="WAVE">Wave</option>
                                    <option value="OM">Orange Money</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mt-3" id="zoneRow" style="display:none;">
                            <div class="col-12 mb-3">
                                <label class="form-label">Zone de livraison</label>
                                <select class="form-select" name="ZoneId" id="zoneId">
                                    <option value="">-- Choisir une zone --</option>
                                    @foreach (var z in zones)
                                    {
                                        <option value="@z.Id" data-fee="@z.PrixLivraison">
                                            @z.Nom - @z.PrixLivraison FCFA
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left"></i> Retour au panier
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-credit-card"></i> Payer <span id="totalAmount">@Model.Total</span> FCFA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-4">Résumé de la commande</h2>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total</span>
                        <span>@Model.Total FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" id="deliveryFeeContainer" style="display: none;">
                        <span>Frais de livraison</span>
                        <span id="deliveryFee">0 FCFA</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span id="grandTotal">@Model.Total</span> FCFA
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const baseTotal = @Model.Total;
        const typeSelect = document.getElementById('typeCommande');
        const zoneRow = document.getElementById('zoneRow');
        const zoneSelect = document.getElementById('zoneId');
        
        function updateDisplay() {
            const isDelivery = typeSelect.value === 'DELIVERY';
            zoneRow.style.display = isDelivery ? 'flex' : 'none';
            
            if (isDelivery && zoneSelect.value) {
                const fee = parseFloat(zoneSelect.options[zoneSelect.selectedIndex].dataset.fee) || 0;
                document.getElementById('deliveryFee').textContent = fee + ' FCFA';
                document.getElementById('deliveryFeeContainer').style.display = 'flex';
                document.getElementById('grandTotal').textContent = (baseTotal + fee);
                document.getElementById('totalAmount').textContent = (baseTotal + fee);
            } else {
                document.getElementById('deliveryFeeContainer').style.display = 'none';
                document.getElementById('grandTotal').textContent = baseTotal;
                document.getElementById('totalAmount').textContent = baseTotal;
            }
        }
        
        typeSelect.addEventListener('change', updateDisplay);
        zoneSelect.addEventListener('change', updateDisplay);
        updateDisplay();
    </script>
}