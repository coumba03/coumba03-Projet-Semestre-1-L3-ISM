@model Burger

<div class="col-lg-4 col-md-6 col-sm-12">
    <div class="product-card @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "no-image" : "")">
        <div class="position-relative">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img class="product-image w-100" src="@Model.ImageUrl" alt="@Model.Nom" />
            }
            else
            {
                <div class="product-image w-100">
                    <span>🍔</span>
                </div>
            }
            @if (Model.Disponible)
            {
                <span class="product-badge">Disponible</span>
            }
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.Nom</h5>
            <p class="card-price">@Model.Prix FCFA</p>
            @if (Model.Disponible)
            {
                <a class="btn btn-view" asp-controller="Catalog" asp-action="Burger" asp-route-id="@Model.Id">
                    <i class="bi bi-eye me-2"></i>Voir les détails
                </a>
            }
            else
            {
                <button class="btn btn-secondary w-100" disabled>
                    <i class="bi bi-dash-circle me-2"></i>Non disponible
                </button>
            }
        </div>
    </div>
</div>
