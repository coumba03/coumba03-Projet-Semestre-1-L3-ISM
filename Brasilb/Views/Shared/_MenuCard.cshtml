@model MenuWithPriceViewModel

<div class="col-lg-4 col-md-6 col-sm-12">
    <div class="product-card @(string.IsNullOrWhiteSpace(Model.Menu.ImageUrl) ? "no-image" : "")">
        <div class="position-relative">
            @if (!string.IsNullOrWhiteSpace(Model.Menu.ImageUrl))
            {
                <img class="product-image w-100" src="@Model.Menu.ImageUrl" alt="@Model.Menu.Nom" />
            }
            else
            {
                <div class="product-image w-100">
                    <span>📦</span>
                </div>
            }
            @if (Model.Menu.Disponible)
            {
                <span class="product-badge">Menu</span>
            }
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.Menu.Nom</h5>
            <p class="text-muted small">Burger + Frites + Boisson</p>
            <div class="price-section mb-3">
                <span class="product-price">@Model.Prix FCFA</span>
            </div>
            @if (Model.Menu.Disponible)
            {
                <a class="btn btn-view" asp-controller="Catalog" asp-action="Menu" asp-route-id="@Model.Menu.Id">
                    <i class="bi bi-eye me-2"></i>Voir les détails
                </a>
            }
            else
            {
                <button class="btn btn-secondary w-100" disabled>
                    <i class="bi bi-dash-circle me-2"></i>Non disponible
                </button>
            }
        </div>
    </div>
</div>
