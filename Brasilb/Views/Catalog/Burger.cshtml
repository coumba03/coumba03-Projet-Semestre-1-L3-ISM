@model BurgerDetailsViewModel
@{
    ViewData["Title"] = Model.Burger.Nom + " - BrasilBurger";
}

<style>
    .burger-hero {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
    }

    .burger-container {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .burger-image {
        height: 400px;
        object-fit: cover;
        background: linear-gradient(135deg, #ecf0f1 0%, #bdc3c7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 6rem;
    }

    .burger-details {
        padding: 2.5rem;
    }

    .burger-title {
        font-size: 2rem;
        font-weight: 800;
        color: #2C3E50;
        margin-bottom: 1rem;
    }

    .burger-price {
        font-size: 2rem;
        font-weight: 800;
        color: #E74C3C;
        margin-bottom: 1.5rem;
    }

    .burger-status {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .burger-status.available {
        background: #D5F4E6;
        color: #27AE60;
    }

    .burger-status.unavailable {
        background: #FADBD8;
        color: #C0392B;
    }

    .form-section {
        margin-bottom: 2.5rem;
    }

    .form-section-title {
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 1rem;
        font-size: 1.1rem;
        border-left: 4px solid #E74C3C;
        padding-left: 1rem;
    }

    .radio-option {
        padding: 1rem;
        border: 2px solid #ecf0f1;
        border-radius: 10px;
        margin-bottom: 0.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .radio-option:hover {
        border-color: #E74C3C;
        background: #FEF5F3;
    }

    .radio-option input[type="radio"]:checked + label {
        color: #E74C3C;
        font-weight: 700;
    }

    .radio-option input[type="radio"]:checked ~ .radio-option {
        border-color: #E74C3C;
        background: #FEF5F3;
    }

    .checkbox-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .checkbox-item {
        padding: 1rem;
        border: 2px solid #ecf0f1;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .checkbox-item:hover {
        border-color: #E74C3C;
        background: #FEF5F3;
    }

    .checkbox-item input[type="checkbox"]:checked {
        accent-color: #E74C3C;
    }

    .quantity-input {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .quantity-input input {
        width: 80px;
        padding: 0.7rem;
        border: 2px solid #ecf0f1;
        border-radius: 8px;
        font-weight: 600;
        text-align: center;
    }

    .quantity-label {
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-add-cart {
        flex: 1;
        padding: 1rem;
        background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
        border: none;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-add-cart:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(39, 174, 96, 0.3);
    }

    .btn-back {
        flex: 1;
        padding: 1rem;
        background: white;
        border: 2px solid #E74C3C;
        color: #E74C3C;
        font-weight: 700;
        font-size: 1.1rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-back:hover {
        background: #FEF5F3;
        color: #E74C3C;
    }

    .breadcrumb-custom {
        background: transparent;
        padding: 0;
        margin-bottom: 2rem;
    }

    .breadcrumb-custom a {
        color: #E74C3C;
        text-decoration: none;
        font-weight: 600;
    }

    .breadcrumb-custom a:hover {
        text-decoration: underline;
    }
</style>

<div class="breadcrumb-custom">
    <a asp-controller="Catalog" asp-action="Index">
        <i class="bi bi-house me-2"></i>Menu
    </a>
    <span class="text-muted mx-2">›</span>
    <span>@Model.Burger.Nom</span>
</div>

<div class="burger-hero">
    <h1 style="margin: 0; font-weight: 800;">@Model.Burger.Nom</h1>
    <p style="margin-top: 0.5rem; font-size: 1.1rem; opacity: 0.95;">Découvrez notre délicieux burger préparé avec les meilleurs ingrédients</p>
</div>

<div class="burger-container">
    <div class="row g-0">
        <div class="col-lg-6">
            @if (!string.IsNullOrWhiteSpace(Model.Burger.ImageUrl))
            {
                <img src="@Model.Burger.ImageUrl" class="burger-image w-100" alt="@Model.Burger.Nom" />
            }
            else
            {
                <div class="burger-image w-100">🍔</div>
            }
        </div>
        <div class="col-lg-6">
            <div class="burger-details">
                <h2 class="burger-title">@Model.Burger.Nom</h2>
                
                <div class="burger-price">@Model.Burger.Prix FCFA</div>

                @if (Model.Burger.Disponible)
                {
                    <span class="burger-status available">
                        <i class="bi bi-check-circle me-2"></i>Disponible
                    </span>
                }
                else
                {
                    <span class="burger-status unavailable">
                        <i class="bi bi-x-circle me-2"></i>Non disponible
                    </span>
                }

                @if (Model.Burger.Disponible)
                {
                    <form method="post" asp-controller="Cart" asp-action="AddBurger">
                        <input type="hidden" name="id" value="@Model.Burger.Id" />

                        <div class="form-section">
                            <div class="form-section-title">
                                
                            </div>
                            <div>
                                <div class="form-check radio-option">
                                    
                                        
                                </div>
                            </div>
                        </div>

                        @if (Model.Complements.Any())
                        {
                            <div class="form-section">
                                <div class="form-section-title">
                                    <i class="bi bi-plus-circle me-2"></i>Complément gratuit
                                </div>
                                <div class="checkbox-group">
                                    @foreach (var c in Model.Complements)
                                    {
                                        <div class="form-check checkbox-item">
                                            <input class="form-check-input" type="checkbox" name="complementIds" value="@c.Id" id="comp@c.Id" />
                                            <label class="form-check-label" for="comp@c.Id">
                                                @c.Nom
                                                <br />
                                                <small class="text-success fw-bold">+@c.Prix FCFA</small>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="bi bi-123 me-2"></i>Quantité
                            </div>
                            <div class="quantity-input">
                                <label class="quantity-label">Nombre d'exemplaires:</label>
                                <input type="number" name="quantite" class="form-control w-auto" value="1" min="1" max="10" />
                            </div>
                        </div>

                        <div class="action-buttons">
                            <button type="submit" class="btn-add-cart">
                                <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                            </button>
                            <a class="btn-back" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-arrow-left"></i>Retour au menu
                            </a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>Ce burger n'est actuellement pas disponible.
                    </div>
                    <a class="btn-back" asp-controller="Catalog" asp-action="Index" style="justify-content: center;">
                        <i class="bi bi-arrow-left"></i>Retour au menu
                    </a>
                }
            </div>
        </div>
    </div>
</div>
