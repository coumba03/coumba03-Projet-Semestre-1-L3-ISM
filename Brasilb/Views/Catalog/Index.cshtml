@model CatalogIndexViewModel
@{
    ViewData["Title"] = "Menu - BrasilBurger";
}

@section Styles {
    <link rel="stylesheet" href="~/css/catalog.css" />
}

<div class="catalog-header">
    <h2>🍽️ Notre Menu</h2>
    <p>Découvrez nos délicieux burgers brésiliens préparés avec amour</p>
</div>

<div class="tab-filters">
    <a class="tab-btn @(Model.Tab == "ALL" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="ALL">
        <i class="bi bi-grid-3x3-gap me-2"></i>Tous les produits
    </a>
    <a class="tab-btn @(Model.Tab == "BURGERS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="BURGERS">
        <i class="bi bi-egg me-2"></i>Burgers
    </a>
    <a class="tab-btn @(Model.Tab == "MENUS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="MENUS">
        <i class="bi bi-box-seam me-2"></i>Menus Complets
    </a>
    <a class="tab-btn @(Model.Tab == "SIDES" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="SIDES">
        <i class="bi bi-square-fill me-2"></i>Frites
    </a>
    <a class="tab-btn @(Model.Tab == "DRINKS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="DRINKS">
        <i class="bi bi-cup-straw me-2"></i>Boissons
    </a>
</div>

@if (Model.Tab == "ALL" || Model.Tab == "BURGERS")
{
    @if (Model.Burgers.Count > 0)
    {
        <div class="category-title">🍔 Nos Burgers</div>
        <div class="row g-4 mb-5">
            @foreach (var b in Model.Burgers)
            {
                <partial name="_BurgerCard" model="b" />
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "MENUS")
{
    @if (Model.Menus.Count > 0)
    {
        <div class="category-title">📦 Menus Complets</div>
        <div class="row g-4 mb-5">
            @foreach (var m in Model.Menus)
            {
                <partial name="_MenuCard" model="m" />
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "SIDES")
{
    @if (Model.Sides.Count > 0)
    {
        <div class="category-title">🍟 Frites & Accompagnements</div>
        <div class="row g-3 mb-5">
            @foreach (var s in Model.Sides)
            {
                <partial name="_ComplementCard" model="s" />
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "DRINKS")
{
    @if (Model.Drinks.Count > 0)
    {
        <div class="category-title">🥤 Boissons</div>
        <div class="row g-3">
            @foreach (var d in Model.Drinks)
            {
                <partial name="_ComplementCard" model="d" />
            }
        </div>
    }
}

@if (Model.Burgers.Count == 0 && Model.Menus.Count == 0 && Model.Sides.Count == 0 && Model.Drinks.Count == 0)
{
    <div class="empty-section">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
        <h3 style="color: #2C3E50; font-weight: 700;">Aucun produit disponible</h3>
        <p class="text-muted">Revenez plus tard pour découvrir nos délicieux burger!</p>
    </div>
}
