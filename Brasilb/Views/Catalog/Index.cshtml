@model CatalogIndexViewModel
@{
    ViewData["Title"] = "Menu - BrasilBurger";
}

<style>
    .catalog-header {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        color: white;
        padding: 2.5rem;
        border-radius: 15px;
        margin-bottom: 3rem;
        text-align: center;
    }

    .catalog-header h2 {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
    }

    .catalog-header p {
        margin-top: 0.5rem;
        font-size: 1.1rem;
        opacity: 0.95;
    }

    .tab-filters {
        display: flex;
        gap: 1rem;
        margin-bottom: 3rem;
        flex-wrap: wrap;
    }

    .tab-btn {
        padding: 0.8rem 1.5rem;
        border: 2px solid #E74C3C;
        background: white;
        color: #E74C3C;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .tab-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
    }

    .tab-btn.active {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        color: white;
        border-color: transparent;
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
    }

    .category-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 2rem;
        position: relative;
        padding-bottom: 1rem;
    }

    .category-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #E74C3C 0%, #F39C12 100%);
        border-radius: 2px;
    }

    .product-card {
        height: 100%;
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        background: white;
    }

    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(231, 76, 60, 0.2);
    }

    .product-image {
        height: 280px;
        object-fit: cover;
        position: relative;
        background: linear-gradient(135deg, #ecf0f1 0%, #bdc3c7 100%);
    }

    .product-card.no-image .product-image {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
    }

    .product-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-title {
        font-weight: 700;
        color: #2C3E50;
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
    }

    .card-price {
        font-size: 1.4rem;
        font-weight: 800;
        color: #E74C3C;
        margin: 1rem 0;
    }

    .btn-view {
        background: linear-gradient(135deg, #E74C3C 0%, #F39C12 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.7rem 1.5rem;
        width: 100%;
        transition: all 0.3s ease;
    }

    .btn-view:hover {
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
        color: white;
    }

    .btn-add {
        background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.7rem 1.5rem;
        width: 100%;
        transition: all 0.3s ease;
    }

    .btn-add:hover {
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(39, 174, 96, 0.3);
        color: white;
    }

    .complement-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid #ecf0f1;
        transition: all 0.3s ease;
    }

    .complement-card:hover {
        border-color: #E74C3C;
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.15);
    }

    .empty-section {
        text-align: center;
        padding: 3rem 1rem;
    }

    .section-separator {
        margin: 3rem 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #E74C3C, transparent);
    }
</style>

<div class="catalog-header">
    <h2>🍽️ Notre Menu</h2>
    <p>Découvrez nos délicieux burgers brésiliens préparés avec amour</p>
</div>

<div class="tab-filters">
    <a class="tab-btn @(Model.Tab == "ALL" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="ALL">
        <i class="bi bi-grid-3x3-gap me-2"></i>Tous les produits
    </a>
    <a class="tab-btn @(Model.Tab == "BURGERS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="BURGERS">
        <i class="bi bi-egg me-2"></i>Burgers
    </a>
    <a class="tab-btn @(Model.Tab == "MENUS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="MENUS">
        <i class="bi bi-box-seam me-2"></i>Menus Complets
    </a>
    <a class="tab-btn @(Model.Tab == "SIDES" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="SIDES">
        <i class="bi bi-square-fill me-2"></i>Frites
    </a>
    <a class="tab-btn @(Model.Tab == "DRINKS" ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-tab="DRINKS">
        <i class="bi bi-cup-straw me-2"></i>Boissons
    </a>
</div>

@if (Model.Tab == "ALL" || Model.Tab == "BURGERS")
{
    @if (Model.Burgers.Count > 0)
    {
        <div class="category-title">🍔 Nos Burgers</div>
        <div class="row g-4 mb-5">
            @foreach (var b in Model.Burgers)
            {
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="product-card @(string.IsNullOrWhiteSpace(b.ImageUrl) ? "no-image" : "")">
                        <div class="position-relative">
                            @if (!string.IsNullOrWhiteSpace(b.ImageUrl))
                            {
                                <img class="product-image w-100" src="@b.ImageUrl" alt="@b.Nom" />
                            }
                            else
                            {
                                <div class="product-image w-100">
                                    <span>🍔</span>
                                </div>
                            }
                            @if (b.Disponible)
                            {
                                <span class="product-badge">Disponible</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@b.Nom</h5>
                            <p class="card-price">@b.Prix FCFA</p>
                            @if (b.Disponible)
                            {
                                <a class="btn btn-view" asp-controller="Catalog" asp-action="Burger" asp-route-id="@b.Id">
                                    <i class="bi bi-eye me-2"></i>Voir les détails
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="bi bi-dash-circle me-2"></i>Non disponible
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "MENUS")
{
    @if (Model.Menus.Count > 0)
    {
        <div class="category-title">📦 Menus Complets</div>
        <div class="row g-4 mb-5">
            @foreach (var m in Model.Menus)
            {
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="product-card @(string.IsNullOrWhiteSpace(m.ImageUrl) ? "no-image" : "")">
                        <div class="position-relative">
                            @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                            {
                                <img class="product-image w-100" src="@m.ImageUrl" alt="@m.Nom" />
                            }
                            else
                            {
                                <div class="product-image w-100">
                                    <span>📦</span>
                                </div>
                            }
                            @if (m.Disponible)
                            {
                                <span class="product-badge">Menu</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@m.Nom</h5>
                            <p class="text-muted small">Burger + Frites + Boisson</p>
                            @if (m.Disponible)
                            {
                                <a class="btn btn-view" asp-controller="Catalog" asp-action="Menu" asp-route-id="@m.Id">
                                    <i class="bi bi-eye me-2"></i>Voir les détails
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="bi bi-dash-circle me-2"></i>Non disponible
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "SIDES")
{
    @if (Model.Sides.Count > 0)
    {
        <div class="category-title">🍟 Frites & Accompagnements</div>
        <div class="row g-3 mb-5">
            @foreach (var s in Model.Sides)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="complement-card">
                        <div class="mb-3">
                            <div style="font-size: 2rem; text-align: center;">🍟</div>
                        </div>
                        <h6 class="fw-bold mb-2">@s.Nom</h6>
                        <p class="card-price mb-3">@s.Prix FCFA</p>
                        <form method="post" asp-controller="Cart" asp-action="AddComplement">
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="hidden" name="quantite" value="1" />
                            <button class="btn btn-add" type="submit">
                                <i class="bi bi-cart-plus me-2"></i>Ajouter
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <div class="section-separator"></div>
    }
}

@if (Model.Tab == "ALL" || Model.Tab == "DRINKS")
{
    @if (Model.Drinks.Count > 0)
    {
        <div class="category-title">🥤 Boissons</div>
        <div class="row g-3">
            @foreach (var d in Model.Drinks)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="complement-card">
                        <div class="mb-3">
                            <div style="font-size: 2rem; text-align: center;">🥤</div>
                        </div>
                        <h6 class="fw-bold mb-2">@d.Nom</h6>
                        <p class="card-price mb-3">@d.Prix FCFA</p>
                        <form method="post" asp-controller="Cart" asp-action="AddComplement">
                            <input type="hidden" name="id" value="@d.Id" />
                            <input type="hidden" name="quantite" value="1" />
                            <button class="btn btn-add" type="submit">
                                <i class="bi bi-cart-plus me-2"></i>Ajouter
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
}

@if (Model.Burgers.Count == 0 && Model.Menus.Count == 0 && Model.Sides.Count == 0 && Model.Drinks.Count == 0)
{
    <div class="empty-section">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
        <h3 style="color: #2C3E50; font-weight: 700;">Aucun produit disponible</h3>
        <p class="text-muted">Revenez plus tard pour découvrir nos délicieux burger!</p>
    </div>
}
