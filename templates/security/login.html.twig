{% extends 'base.html.twig' %}

{% block title %}Connexion - Brasil Burger{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-box">
            <div class="login-header">
                <div class="login-logo">
                    <i class="fas fa-hamburger"></i>
                </div>
                <h1>Brasil Burger</h1>
                <p>Gestion Administrative</p>
            </div>

            <div class="login-content">
                {% if error %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="login-form">
                    <div class="form-group">
                        <label for="username" class="form-label">
                            <i class="fas fa-envelope me-2"></i>Email
                        </label>
                        <input 
                            type="email" 
                            id="username"
                            name="_username" 
                            class="form-control" 
                            value="{{ last_username }}" 
                            placeholder="votre@email.com"
                            required 
                            autofocus
                        >
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock me-2"></i>Mot de passe
                        </label>
                        <input 
                            type="password" 
                            id="password"
                            name="_password" 
                            class="form-control" 
                            placeholder="••••••••"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-login w-100" type="submit">
                        <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                    </button>
                </form>
            </div>

            <div class="login-footer">
                <p class="text-muted">© 2025 Brasil Burger - Tous droits réservés</p>
            </div>
        </div>
    </div>

<style>
/* Masquer sidebar et topbar uniquement sur la page de login */
body:has(.login-container) .sidebar,
body:has(.login-container) .topbar {
    display: none !important;
}

body:has(.login-container) .main-content {
    margin-left: 0 !important;
    padding-top: 0 !important;
}

/* Fallback pour les navigateurs qui ne supportent pas :has() */
.login-page .sidebar,
.login-page .topbar {
    display: none !important;
}

.login-page .main-content {
    margin-left: 0 !important;
    padding-top: 0 !important;
}

/* Réduire la taille du formulaire */
.login-box {
    max-width: 380px !important;
}

.login-header {
    padding: 32px 24px !important;
}

.login-content {
    padding: 24px !important;
}

.login-logo {
    font-size: 3rem !important;
    margin-bottom: 12px !important;
}

.login-header h1 {
    font-size: 1.8rem !important;
    margin: 12px 0 6px !important;
}

.form-group {
    margin-bottom: 18px !important;
}

.login-footer {
    padding: 18px 24px !important;
}
</style>

<script>
// Ajouter une classe au body pour identifier la page de login
document.body.classList.add('login-page');
</script>
{% endblock %}