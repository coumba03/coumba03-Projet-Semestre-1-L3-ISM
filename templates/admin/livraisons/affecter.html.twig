{% extends 'base.html.twig' %}

{% block page_title %}Affecter livraisons{% endblock %}
{% block title %}Affecter livraisons{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Affectation des livraisons</h1>
        <div>
            <a class="btn btn-primary me-2" href="{{ path('admin_livraisons_grouper') }}">
                <i class="fas fa-layer-group me-1"></i>Regrouper par zones
            </a>
            <a class="btn btn-outline-dark" href="{{ path('admin_livraisons_index') }}">Suivi livraisons</a>
        </div>
    </div>

    {% if commandes is empty %}
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-truck fa-4x text-muted"></i>
            </div>
            <h4 class="text-muted mb-2">Aucune commande à affecter</h4>
            <p class="text-muted">Les commandes DELIVERY avec le statut TERMINER apparaîtront ici</p>
            <a href="{{ path('admin_commandes_index') }}" class="btn btn-outline-primary">
                <i class="fas fa-receipt me-1"></i>Voir les commandes
            </a>
        </div>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th>Client</th>
                            <th>Zone</th>
                            <th>Date</th>
                            <th class="text-end">Montant</th>
                            <th>Affectation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in commandes %}
                            <tr>
                                <td>#{{ c.id }}</td>
                                <td>
                                    {% if c.client %}
                                        {{ c.client.prenom }} {{ c.client.nom }}<br>
                                        <small class="text-muted">{{ c.client.telephone }}</small>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if c.zone %}
                                        <span class="badge bg-info">{{ c.zone.nom }}</span>
                                    {% else %}
                                        <span class="text-warning">Aucune zone</span>
                                    {% endif %}
                                </td>
                                <td>{{ c.dateCommande|date('Y-m-d H:i') }}</td>
                                <td class="text-end">{{ c.montantTotal }}CFA</td>
                                <td style="min-width: 250px;">
                                    <form class="d-flex gap-2" method="post" action="{{ path('admin_livraisons_affecter_post') }}">
                                        <input type="hidden" name="commande_id" value="{{ c.id }}">
                                        <input type="hidden" name="zone_id" value="{{ c.zone ? c.zone.id : '' }}">
                                        
                                        <select name="livreur_id" class="form-select" required>
                                            <option value="">Choisir un livreur</option>
                                            {% for l in livreurs %}
                                                <option value="{{ l.id }}">{{ l.prenom }} {{ l.nom }}</option>
                                            {% endfor %}
                                        </select>
                                        
                                        <button class="btn btn-dark">Affecter</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {% include 'components/pagination.html.twig' with {'paginator': paginator, 'filters': {}} only %}
{% endblock %}
