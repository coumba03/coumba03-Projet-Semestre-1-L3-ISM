{% extends 'base.html.twig' %}

{% block page_title %}Dashboard{% endblock %}
{% block title %}Dashboard - Brasil Burger{% endblock %}

{% block body %}
    <div class="mb-4">
        <h1 class="h2 mb-1">Statistiques du jour</h1>
        <p class="text-muted">Suivi en temps réel de votre activité</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6 col-xl-3">
            <div class="stat-card stat-en-cours">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Commandes en cours</div>
                        <div class="stat-value">{{ stats.commandes_en_cours }}</div>
                    </div>
                    <i class="fas fa-spinner stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="stat-card stat-validee">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Commandes validées</div>
                        <div class="stat-value">{{ stats.commandes_validees }}</div>
                    </div>
                    <i class="fas fa-check-circle stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="stat-card stat-annulee">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Commandes annulées</div>
                        <div class="stat-value">{{ stats.commandes_annulees }}</div>
                    </div>
                    <i class="fas fa-times-circle stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-xl-3">
            <div class="stat-card stat-recettes">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="stat-label">Recettes</div>
                        <div class="stat-value">
                            {{ stats.recettes|number_format(0, '.', ' ') }} F
                        </div>
                    </div>
                    <i class="fas fa-money-bill-wave stat-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- TOP BURGERS -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-hamburger me-2"></i>Top burgers vendus (jour)
                </div>
                <div class="card-body p-0">
                    {% if stats.top_burgers|length > 0 %}
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Burger</th>
                                    <th class="text-end">Quantité</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for b in stats.top_burgers %}
                                    <tr>
                                        <td>{{ b.nom }}</td>
                                        <td class="text-end">
                                            <span class="badge bg-danger">
                                                {{ b.total_quantite }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-2x"></i>
                            <p class="mt-3">Aucune vente burger aujourd’hui</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- TOP MENUS (SÉCURISÉ) -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-list me-2"></i>Top menus vendus (jour)
                </div>
                <div class="card-body p-0">
                    {% set topMenus = stats.top_menus|default([]) %}

                    {% if topMenus|length > 0 %}
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Menu</th>
                                    <th class="text-end">Quantité</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for m in topMenus %}
                                    <tr>
                                        <td>{{ m.nom }}</td>
                                        <td class="text-end">
                                            <span class="badge bg-success">
                                                {{ m.total_quantite }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-2x"></i>
                            <p class="mt-3">Aucune vente menu aujourd’hui</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
{% endblock %}
